{
  "type": "object",
  "required": ["title", "isbn", "price_vnd", "category_id"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "isbn": {
      "type": "string",
      "pattern": "^[0-9]{13}$"
    },
    "price_vnd": {
      "type": "integer",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "category_id": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}